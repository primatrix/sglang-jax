      "isDeleted": false,
      "boundElements": [],
      "updated": 1789019929100,
      "link": null,
      "locked": false,
      "text": "容量保证：每 lane 有效行数 ≤ K  ⇒  Σ item 有效行数 ≤ L × K  ⇒  原序紧密排列仍装得下。",
      "originalText": "容量保证：每 lane 有效行数 ≤ K  ⇒  Σ item 有效行数 ≤ L × K  ⇒  原序紧密排列仍装得下。",
      "fontSize": 25,
      "fontFamily": 8,
      "lineHeight": 1.3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "index": "b0Q"
    },
    {
      "id": "epd-replicated-output-90",
      "type": "text",
      "x": 45,
      "y": 1265,
      "width": 1170.19970703125,
      "height": 28.6,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
